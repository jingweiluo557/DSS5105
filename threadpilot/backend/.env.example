# Local development configuration: copy to backend/.env.
# Start local MySQL and provision accounts before starting the application.
# Root/admin credentials belong only in the initialization process environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT_SECONDS=60
# Dataset replay clock (timezone required); use live for real scheduling.
BUSINESS_NOW=live
# Optional private SQLite location; defaults to backend/runtime/workflow.sqlite3
# WORKFLOW_DB=
# Delivery gateway must honour Idempotency-Key and return status=sent and receipt.
CHASE_WEBHOOK_URL=
CHASE_WEBHOOK_TOKEN=
# Optional default address for drafts addressed to Me. Blank asks before send preview.
CHASE_SELF_RECIPIENT=
REPLY_INGEST_TOKEN=

# MySQL 8; URL-encode special characters in connection passwords.
# Save these once; provision_mysql reads this file automatically.
# Keep these passwords identical to the corresponding connection URLs below.
MYSQL_APP_PASSWORD=replace_with_random_app_hex
MYSQL_AI_PASSWORD=replace_with_random_ai_hex
DATABASE_URL=mysql+pymysql://threadpilot_app:CHANGE_ME@127.0.0.1:3306/threadpilot?charset=utf8mb4
AI_DATABASE_URL=mysql+pymysql://threadpilot_ai:CHANGE_ME@127.0.0.1:3306/threadpilot?charset=utf8mb4
OPENAI_BASE_URL=https://api.openai.com/v1
DATA_API_TOKEN=
SYNC_ENABLED=false
SYNC_INTERVAL_MINUTES=5
SYNC_FILES=["source.xlsx"]
SQL_MAX_ROWS=100
SQL_TIMEOUT_MS=5000
SQL_AGENT_STEPS=16
MAX_UPLOAD_BYTES=10485760

# Use chat_completions for providers exposing Chat Completions + JSON mode only.
INTENT_API_STYLE=responses

# Optional separate frontend origin, e.g. GitHub Pages (JSON list).
# CORS_ORIGINS=["https://jingweiluo557.github.io"]

# HTTP cloud function mode (private values generated by scripts.cloud_function_config).
WORKFLOW_STORAGE=sqlite
BACKGROUND_TASKS_ENABLED=true
MORNING_SCHEDULER_ENABLED=false
# Enable the persistent worker for daily 07:00 Asia/Shanghai email checks.
EMAIL_SCHEDULER_ENABLED=false
# Manager alert emails (P1 immediately, P2 digests at 07:00/14:00). false = dry run, decisions only.
ALERT_EMAILS_ENABLED=false
SERVE_FRONTEND=true
API_ACCESS_TOKEN=
SCHEDULER_TOKEN=
# Personal Outlook OAuth (Web callback, single-owner local deployment).
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:8000/api/outlook/callback
OUTLOOK_AUTHORITY=https://login.microsoftonline.com/consumers

# For separate frontend hosting, return here after Outlook authorization.
PUBLIC_FRONTEND_ORIGIN=
OUTLOOK_ENCRYPTION_KEY=
# OUTLOOK_STORE=runtime/outlook.sqlite3

# Persist the shared running business clock configured in Settings.
# BUSINESS_CLOCK_STORE=runtime/business-clock.sqlite3
