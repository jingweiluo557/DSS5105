# Local development configuration: copy to backend/.env.
# Start local MySQL and provision accounts before starting the application.
# Root/admin credentials belong only in the initialization process environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT_SECONDS=60
# Dataset replay clock (timezone required); use live for real scheduling.
BUSINESS_NOW=live
# Optional private SQLite location; defaults to backend/runtime/workflow.sqlite3
# WORKFLOW_DB=
# Delivery gateway must honour Idempotency-Key and return status=sent and receipt.
CHASE_WEBHOOK_URL=
CHASE_WEBHOOK_TOKEN=
REPLY_INGEST_TOKEN=

# MySQL 8; URL-encode special characters in connection passwords.
# Save these once; provision_mysql reads this file automatically.
# Keep these passwords identical to the corresponding connection URLs below.
MYSQL_APP_PASSWORD=replace_with_random_app_hex
MYSQL_AI_PASSWORD=replace_with_random_ai_hex
DATABASE_URL=mysql+pymysql://threadpilot_app:CHANGE_ME@127.0.0.1:3306/threadpilot?charset=utf8mb4
AI_DATABASE_URL=mysql+pymysql://threadpilot_ai:CHANGE_ME@127.0.0.1:3306/threadpilot?charset=utf8mb4
OPENAI_BASE_URL=https://api.openai.com/v1
DATA_API_TOKEN=
SYNC_ENABLED=false
SYNC_INTERVAL_MINUTES=5
SYNC_FILES=["source.xlsx"]
SQL_MAX_ROWS=100
SQL_TIMEOUT_MS=5000
SQL_AGENT_STEPS=16
MAX_UPLOAD_BYTES=10485760

# Use chat_completions for providers exposing Chat Completions + JSON mode only.
INTENT_API_STYLE=responses
