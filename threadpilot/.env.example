# Copy to .env in repository root for Docker Compose.
# Passwords below MUST be replaced; use URL-safe hex passwords (secrets.token_hex(24)).
MYSQL_ROOT_PASSWORD=replace_with_random_root_hex
MYSQL_APP_PASSWORD=replace_with_random_app_hex
MYSQL_AI_PASSWORD=replace_with_random_ai_hex
MYSQL_PORT=3306
API_PORT=8000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT_SECONDS=60
DATA_API_TOKEN=replace_with_random_management_token
# Business clock. The seed data ends on 2026-03-31, so for a reproducible run use the dataset's morning.
# Use live (the real clock) only once the database receives current data.
BUSINESS_NOW=2026-04-01T08:00:00+08:00
SYNC_ENABLED=false
SYNC_INTERVAL_MINUTES=5
SYNC_FILES=["source.xlsx"]
SQL_MAX_ROWS=100
SQL_TIMEOUT_MS=5000
SQL_AGENT_STEPS=16
CHASE_WEBHOOK_URL=
CHASE_WEBHOOK_TOKEN=
REPLY_INGEST_TOKEN=

# Use chat_completions for providers exposing Chat Completions + JSON mode only.
INTENT_API_STYLE=responses
MYSQL_DATABASE=threadpilot
MYSQL_APP_USER=threadpilot_app
MYSQL_AI_USER=threadpilot_ai

# Bounded retries when the model provider rate-limits or drops a connection, and a per-device limit on questions that call
# the model (a cost guard for a shared demo link; 0 turns it off). The OpenAI spending limit is still the real cap.
OPENAI_MAX_RETRIES=2
CHAT_REQUESTS_PER_MINUTE=40

# First recipients of the morning summary email (comma-separated). After that each draft reuses the last list used.
BRIEFING_EMAIL_TO=
