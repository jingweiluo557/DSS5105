# Copy to .env in repository root for Docker Compose.
# Passwords below MUST be replaced; use URL-safe hex passwords (secrets.token_hex(24)).
MYSQL_ROOT_PASSWORD=replace_with_random_root_hex
MYSQL_APP_PASSWORD=replace_with_random_app_hex
MYSQL_AI_PASSWORD=replace_with_random_ai_hex
MYSQL_PORT=3306
API_PORT=8000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT_SECONDS=60
DATA_API_TOKEN=replace_with_random_management_token
BUSINESS_NOW=live
SYNC_ENABLED=false
SYNC_INTERVAL_MINUTES=5
SYNC_FILES=["source.xlsx"]
SQL_MAX_ROWS=100
SQL_TIMEOUT_MS=5000
SQL_AGENT_STEPS=16
CHASE_WEBHOOK_URL=
CHASE_WEBHOOK_TOKEN=
REPLY_INGEST_TOKEN=

# Use chat_completions for providers exposing Chat Completions + JSON mode only.
INTENT_API_STYLE=responses
MYSQL_DATABASE=threadpilot
MYSQL_APP_USER=threadpilot_app
MYSQL_AI_USER=threadpilot_ai

# Persistent workflow state in MySQL; required for multiple cloud instances.
WORKFLOW_STORAGE=database
BACKGROUND_TASKS_ENABLED=true
MORNING_SCHEDULER_ENABLED=false
SERVE_FRONTEND=true
# Set distinct random tokens before exposing the API publicly.
API_ACCESS_TOKEN=
SCHEDULER_TOKEN=
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
